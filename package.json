{
  "name": "life-leaf",
  "version": "0.0.1",
  "author": "Anand Raja",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "develop": "ng serve --port 3035",
    "build": "ng build",
    "build:gh": "ng build --base-href /life-leaf/",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android && node scripts/patch-android.mjs",
    "android:patch": "node scripts/patch-android.mjs",
    "android:open": "npx cap open android",
    "android:version": "node scripts/bump-android-version.js",
    "android:version:patch": "node scripts/bump-android-version.js --patch",
    "android:version:minor": "node scripts/bump-android-version.js --minor",
    "android:version:major": "node scripts/bump-android-version.js --major",
    "generate-keystore": "node scripts/generate-keystore.mjs",
    "demo:notification-backup": "node scripts/generate-notification-demo-backup.mjs",
    "keystore:type": "node scripts/detect-keystore-format.mjs release-keystore.jks",
    "watch": "ng build --watch --configuration development",
    "copy-error-page": "cp www/index.html www/404.html",
    "test": "ng test",
    "precommit:dummy": "echo 'This is a dummy print message!'",
    "precommit": "run-s format:fix lint",
    "format:fix": "pretty-quick --staged",
    "format:check": "prettier --config ./.prettierrc --list-different \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "format:all": "prettier --config ./.prettierrc --write \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.1",
    "@angular/compiler": "22.0.1",
    "@angular/core": "22.0.1",
    "@angular/forms": "22.0.1",
    "@angular/platform-browser": "22.0.1",
    "@angular/router": "22.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/angular": "^9.0.0",
    "@tiptap/core": "3.30.1",
    "@tiptap/extension-highlight": "3.30.1",
    "@tiptap/extension-link": "3.30.1",
    "@tiptap/extension-task-item": "3.30.1",
    "@tiptap/extension-task-list": "3.30.1",
    "@tiptap/extension-text-align": "3.30.1",
    "@tiptap/extension-underline": "3.30.1",
    "@tiptap/starter-kit": "3.30.1",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.1",
    "@angular/cli": "22.0.1",
    "@angular/compiler-cli": "22.0.1",
    "@angular/language-service": "22.0.1",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "^10.0.1",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  },
  "description": "A private diary to capture your thoughts, memories, moods, and everyday moments.",
  "engines": {
    "node": ">=22.22.3 || >=24.15.0 || >=26.0.0"
  }
}
